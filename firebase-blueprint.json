{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile stored under users/{userId}",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "blocked": { "type": "boolean" },
        "blockedReason": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "WatchlistItem": {
      "title": "WatchlistItem",
      "description": "User saved anime, donghua, manga, novel, or movie watchlist item",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "key": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_:\\-]+$" },
        "kind": { "type": "string", "enum": ["anime", "donghua", "manga", "manhwa", "novel", "movie", "tv"] },
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 300 },
        "image": { "type": "string", "maxLength": 1200 },
        "href": { "type": "string", "maxLength": 300 },
        "status": { "type": "string", "enum": ["watching", "planning", "completed", "paused", "dropped"] },
        "favorite": { "type": "boolean" },
        "progress": { "type": "number" },
        "total": { "type": "number" },
        "score": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "key", "kind", "id", "title", "href", "status", "createdAt", "updatedAt"]
    },
    "HistoryItem": {
      "title": "HistoryItem",
      "description": "User continue-watching or continue-reading history item",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "key": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_:\\-]+$" },
        "kind": { "type": "string", "enum": ["anime", "donghua", "manga", "manhwa", "novel", "movie", "tv"] },
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 300 },
        "image": { "type": "string", "maxLength": 1200 },
        "href": { "type": "string", "maxLength": 300 },
        "subtitle": { "type": "string", "maxLength": 160 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "key", "kind", "id", "title", "href", "subtitle", "updatedAt"]
    },
    "UserSubscription": {
      "title": "UserSubscription",
      "description": "User monthly ₹25 VIP subscription and ₹2 single-episode pass credits tied to account",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "plan": { "type": "string", "enum": ["monthly_25", "extra_2"] },
        "amountInr": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "active", "rejected", "expired"] },
        "referenceNumber": { "type": "string", "maxLength": 100 },
        "screenshotName": { "type": "string", "maxLength": 200 },
        "requestId": { "type": "string", "maxLength": 128 },
        "adminNote": { "type": "string", "maxLength": 300 },
        "startedAtMs": { "type": "number" },
        "expiresAtMs": { "type": "number" },
        "extraCredits": { "type": "number" },
        "extraApprovedAtMs": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "plan", "amountInr", "status", "referenceNumber", "startedAtMs", "expiresAtMs", "updatedAt"]
    },
    "PaymentRequest": {
      "title": "PaymentRequest",
      "description": "User-submitted ₹25 VIP or ₹2 extra-episode payment confirmation awaiting owner approval or rejection",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_:\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userEmail": { "type": "string", "format": "email", "maxLength": 254 },
        "userName": { "type": "string", "maxLength": 120 },
        "plan": { "type": "string", "enum": ["monthly_25", "extra_2"] },
        "amountInr": { "type": "number" },
        "referenceNumber": { "type": "string", "maxLength": 100 },
        "screenshotName": { "type": "string", "maxLength": 200 },
        "confirmedPaid": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "adminNote": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "userEmail", "plan", "amountInr", "referenceNumber", "confirmedPaid", "status", "createdAt", "updatedAt"]
    },
    "DailyWatchUsage": {
      "title": "DailyWatchUsage",
      "description": "Tracks daily watched video keys per user per day (5 free daily + unlocked ₹2 episodes, resets at 12:00 AM midnight)",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "dateKey": { "type": "string", "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "watchedKeys": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "dateKey", "watchedKeys", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Authenticated user profile document isolated to its owner"
    },
    "/users/{userId}/watchlist/{itemKey}": {
      "schema": { "$ref": "#/entities/WatchlistItem" },
      "description": "User watchlist items for watch-later and progress tracking"
    },
    "/users/{userId}/history/{itemKey}": {
      "schema": { "$ref": "#/entities/HistoryItem" },
      "description": "User continue watching and reading history"
    },
    "/users/{userId}/subscription/{subId}": {
      "schema": { "$ref": "#/entities/UserSubscription" },
      "description": "User 30-day Royal Pass VIP subscription document"
    },
    "/users/{userId}/usage/{dateKey}": {
      "schema": { "$ref": "#/entities/DailyWatchUsage" },
      "description": "Daily free video limit tracking for non-subscribed users"
    },
    "/paymentRequests/{requestId}": {
      "schema": { "$ref": "#/entities/PaymentRequest" },
      "description": "Payment verification requests reviewed by owner admin"
    }
  }
}
