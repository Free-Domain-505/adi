rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'addii0987654@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_:\\-]+$');
    }

    function isValidDateKey(k) {
      return k is string && k.size() == 10 && k.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isNotBlocked(uid) {
      return !exists(/databases/$(database)/documents/users/$(uid))
        || !('blocked' in get(/databases/$(database)/documents/users/$(uid)).data)
        || get(/databases/$(database)/documents/users/$(uid)).data.blocked != true;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoURL', 'blocked', 'blockedReason', 'createdAt', 'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && data.email is string
        && data.email.size() <= 254
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && (!('blocked' in data) || data.blocked is bool)
        && (!('blockedReason' in data) || (data.blockedReason is string && data.blockedReason.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWatchlistItem(data, userId, itemKey) {
      return data.keys().hasAll(['userId', 'key', 'kind', 'id', 'title', 'href', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'userId', 'key', 'kind', 'id', 'title', 'image', 'href',
          'status', 'favorite', 'progress', 'total', 'score', 'createdAt', 'updatedAt'
        ])
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.key is string
        && data.key == itemKey
        && data.kind in ['anime', 'donghua', 'manga', 'manhwa', 'novel', 'movie', 'tv']
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && (!('image' in data) || (data.image is string && data.image.size() <= 1200))
        && data.href is string && data.href.size() >= 1 && data.href.size() <= 300
        && data.status in ['watching', 'planning', 'completed', 'paused', 'dropped']
        && (!('favorite' in data) || data.favorite is bool)
        && (!('progress' in data) || data.progress == null || (data.progress is number && data.progress >= 0 && data.progress <= 10000))
        && (!('total' in data) || data.total == null || (data.total is number && data.total >= 0 && data.total <= 10000))
        && (!('score' in data) || data.score == null || (data.score is number && data.score >= 0 && data.score <= 100))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidHistoryItem(data, userId, itemKey) {
      return data.keys().hasAll(['userId', 'key', 'kind', 'id', 'title', 'href', 'subtitle', 'updatedAt'])
        && data.keys().hasOnly([
          'userId', 'key', 'kind', 'id', 'title', 'image', 'href', 'subtitle', 'updatedAt'
        ])
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.key is string
        && data.key == itemKey
        && data.kind in ['anime', 'donghua', 'manga', 'manhwa', 'novel', 'movie', 'tv']
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && (!('image' in data) || (data.image is string && data.image.size() <= 1200))
        && data.href is string && data.href.size() >= 1 && data.href.size() <= 300
        && data.subtitle is string && data.subtitle.size() <= 160
        && data.updatedAt is timestamp;
    }

    function isValidSubscription(data, userId) {
      return data.keys().hasAll([
          'userId', 'plan', 'amountInr', 'status', 'referenceNumber', 'startedAtMs', 'expiresAtMs', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'plan', 'amountInr', 'status', 'referenceNumber', 'screenshotName',
          'requestId', 'adminNote', 'startedAtMs', 'expiresAtMs', 'extraCredits', 'extraApprovedAtMs', 'updatedAt'
        ])
        && data.userId is string
        && data.userId == userId
        && data.plan in ['monthly_25', 'extra_2']
        && ((data.plan == 'monthly_25' && data.amountInr == 25) || (data.plan == 'extra_2' && data.amountInr == 2))
        && data.status in ['pending', 'active', 'rejected', 'expired']
        && data.referenceNumber is string && data.referenceNumber.size() >= 4 && data.referenceNumber.size() <= 100
        && (!('screenshotName' in data) || (data.screenshotName is string && data.screenshotName.size() <= 200))
        && (!('requestId' in data) || (data.requestId is string && data.requestId.size() <= 128))
        && (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 300))
        && (!('extraCredits' in data) || (data.extraCredits is number && data.extraCredits >= 0 && data.extraCredits <= 50))
        && (!('extraApprovedAtMs' in data) || (data.extraApprovedAtMs is number && data.extraApprovedAtMs >= 0))
        && data.startedAtMs is number && data.startedAtMs >= 0
        && data.expiresAtMs is number && data.expiresAtMs >= 0
        && (
          data.status != 'active'
          || (data.plan == 'monthly_25' && data.startedAtMs > 0 && data.expiresAtMs > data.startedAtMs)
          || (data.plan == 'extra_2' && data.startedAtMs == 0 && data.expiresAtMs == 0)
        )
        && data.updatedAt is timestamp;
    }

    function isValidPaymentRequest(data, requestId) {
      return data.keys().hasAll([
          'id', 'userId', 'userEmail', 'plan', 'amountInr', 'referenceNumber',
          'confirmedPaid', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'userEmail', 'userName', 'plan', 'amountInr',
          'referenceNumber', 'screenshotName', 'confirmedPaid', 'status',
          'adminNote', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == requestId
        && data.userId is string && isValidId(data.userId)
        && data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 254
        && (!('userName' in data) || (data.userName is string && data.userName.size() <= 120))
        && data.plan in ['monthly_25', 'extra_2']
        && ((data.plan == 'monthly_25' && data.amountInr == 25) || (data.plan == 'extra_2' && data.amountInr == 2))
        && data.referenceNumber is string && data.referenceNumber.size() >= 4 && data.referenceNumber.size() <= 100
        && (!('screenshotName' in data) || (data.screenshotName is string && data.screenshotName.size() <= 200))
        && data.confirmedPaid is bool
        && data.status in ['pending', 'approved', 'rejected']
        && (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUsage(data, userId, dateKey) {
      return data.keys().hasAll(['userId', 'dateKey', 'watchedKeys', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'dateKey', 'watchedKeys', 'updatedAt'])
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.dateKey is string
        && data.dateKey == dateKey
        && data.watchedKeys is list
        && data.watchedKeys.size() <= 50
        && (data.watchedKeys.size() == 0 || (data.watchedKeys[0] is string && data.watchedKeys[0].size() <= 128))
        && data.updatedAt is timestamp;
    }

    // Connection test document (read-only ping)
    match /test/connection {
      allow get: if true;
    }

    // User profile (PII isolated strictly to owner or admin)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && !('blocked' in incoming())
        && !('blockedReason' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt']))
          || (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['blocked', 'blockedReason', 'updatedAt']))
        );
      allow delete: if isValidId(userId) && isOwner(userId);

      match /watchlist/{itemKey} {
        allow get: if isValidId(userId) && isValidId(itemKey) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(itemKey)
          && isOwner(userId)
          && isValidWatchlistItem(incoming(), userId, itemKey)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(itemKey)
          && isOwner(userId)
          && isValidWatchlistItem(incoming(), userId, itemKey)
          && incoming().userId == existing().userId
          && incoming().key == existing().key
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'image', 'href', 'status', 'favorite', 'progress', 'total', 'score', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(itemKey) && isOwner(userId);
      }

      match /history/{itemKey} {
        allow get: if isValidId(userId) && isValidId(itemKey) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(itemKey)
          && isOwner(userId)
          && isValidHistoryItem(incoming(), userId, itemKey)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(itemKey)
          && isOwner(userId)
          && isValidHistoryItem(incoming(), userId, itemKey)
          && incoming().userId == existing().userId
          && incoming().key == existing().key
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'image', 'href', 'subtitle', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(itemKey) && isOwner(userId);
      }

      match /subscription/{subId} {
        allow get: if isValidId(userId) && subId == 'current' && (isOwner(userId) || isAdmin());
        allow create: if isValidId(userId)
          && subId == 'current'
          && isValidSubscription(incoming(), userId)
          && incoming().updatedAt == request.time
          && (
            (
              isOwner(userId)
              && incoming().userId == request.auth.uid
              && incoming().status == 'pending'
              && incoming().startedAtMs == 0
              && incoming().expiresAtMs == 0
              && !('extraCredits' in incoming())
              && !('extraApprovedAtMs' in incoming())
            )
            || isAdmin()
          );
        allow update: if isValidId(userId)
          && subId == 'current'
          && isValidSubscription(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().updatedAt == request.time
          && (
            (
              isOwner(userId)
              && incoming().userId == request.auth.uid
              && (
                (
                  incoming().status == 'pending'
                  && incoming().startedAtMs == 0
                  && incoming().expiresAtMs == 0
                  && incoming().diff(existing()).affectedKeys().hasOnly([
                    'plan', 'amountInr', 'status', 'referenceNumber', 'screenshotName', 'requestId', 'startedAtMs', 'expiresAtMs', 'updatedAt'
                  ])
                )
                || (
                  'extraCredits' in existing()
                  && existing().extraCredits is number
                  && existing().extraCredits >= 1
                  && 'extraCredits' in incoming()
                  && incoming().extraCredits == existing().extraCredits - 1
                  && incoming().diff(existing()).affectedKeys().hasOnly(['extraCredits', 'updatedAt'])
                )
              )
            )
            || isAdmin()
          );
      }

      match /usage/{dateKey} {
        allow get: if isValidId(userId) && isValidDateKey(dateKey) && isOwner(userId);
        allow create: if isValidId(userId)
          && isValidDateKey(dateKey)
          && isOwner(userId)
          && isValidUsage(incoming(), userId, dateKey)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidDateKey(dateKey)
          && isOwner(userId)
          && isValidUsage(incoming(), userId, dateKey)
          && incoming().userId == existing().userId
          && incoming().dateKey == existing().dateKey
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['watchedKeys', 'updatedAt']);
      }
    }

    // Payment confirmation requests reviewed by owner admin
    match /paymentRequests/{requestId} {
      allow get: if isValidId(requestId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(requestId)
        && isSignedIn()
        && isValidPaymentRequest(incoming(), requestId)
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().confirmedPaid == true
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isNotBlocked(request.auth.uid);
      allow update: if isValidId(requestId)
        && isAdmin()
        && isValidPaymentRequest(incoming(), requestId)
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNote', 'updatedAt']);
      allow delete: if isValidId(requestId) && isAdmin();
    }
  }
}
